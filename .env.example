# ---------------------------------------------------------------------------
# Variables d'environnement du site
#
# Copie ce fichier en .env.local pour le développement. .env.local n'est jamais
# versionné, voir .gitignore.
#
# Le site fonctionne sans aucune de ces variables : le stockage retombe sur des
# fichiers JSON dans .data/ et les emails s'affichent dans la console. C'est
# volontaire, ça permet de tout essayer avant de brancher quoi que ce soit.
# En production sur Vercel, elles se règlent dans Settings puis Environment
# Variables, et ne s'appliquent qu'au déploiement suivant.
# ---------------------------------------------------------------------------

# --- Indispensable en production -------------------------------------------

# Signe les liens de confirmation et la session d'administration.
# Sans elle, la connexion à /admin échoue et le serveur refuse de démarrer en
# production plutôt que de signer avec une valeur devinable.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Mot de passe de /admin.
ADMIN_PASSWORD=

# --- Notifications ----------------------------------------------------------

# Adresse qui reçoit les propositions de sorties et les commentaires.
ADMIN_EMAIL=

# Envoi des emails par SMTP. Tant que les deux ne sont pas remplies, les
# messages sont écrits dans la console du serveur, liens de confirmation compris.
# Avec Gmail, SMTP_PASS est un mot de passe d'application, pas le mot de passe
# habituel du compte.
SMTP_USER=
SMTP_PASS=

# Facultatif, seulement si tu n'utilises pas Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=

# --- Stockage ---------------------------------------------------------------

# Ajoutée automatiquement par Vercel à la création du store Blob.
# Absente, le site range tout dans .data/ en local.
BLOB_READ_WRITE_TOKEN=

# --- Publication ------------------------------------------------------------

# Reconstruit le site quand une sortie est approuvée depuis /admin. Sans elle,
# la sortie n'apparaît qu'au déploiement suivant.
# Vercel, Settings puis Git puis Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=

# Adresse publique du site, utilisée dans les liens des emails et les balises
# de partage. Sans elle, Vercel fournit l'adresse de production, et en local on
# retombe sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
