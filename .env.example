# Copie ce fichier en .env.local pour le développement.
# En ligne, les mêmes clés se règlent dans Vercel → Settings → Environment Variables.
#
# Rien n'est obligatoire pour lancer le site : sans SMTP_USER ni SMTP_PASS,
# les emails s'affichent dans la console et le parcours reste testable.

# Signe les liens de confirmation et la session admin. Indispensable pour /admin.
APP_SECRET=

# Mot de passe de la page /admin.
ADMIN_PASSWORD=

# Adresse qui reçoit les notifications : propositions, commentaires, messages de contact.
ADMIN_EMAIL=toi@ton-domaine.fr

# Compte Gmail qui envoie, et son mot de passe d'application (pas le mot de passe habituel).
SMTP_USER=
SMTP_PASS=

# Adresse affichée comme expéditeur. Sans elle, SMTP_USER est utilisée.
# Une adresse différente de SMTP_USER doit être déclarée dans Gmail,
# Paramètres → Comptes → « Envoyer des emails en tant que ».
SMTP_FROM=toi@ton-domaine.fr

# Remet le site en ligne après une publication ou une correction acceptée.
VERCEL_DEPLOY_HOOK_URL=

# Nom affiché dans les mentions légales, un prénom suffit.
NEXT_PUBLIC_LEGAL_NAME=

# Injecté automatiquement par Vercel à la création du store Blob.
BLOB_READ_WRITE_TOKEN=
